APP_ENV=development
CORS_ORIGINS=http://localhost:3000
API_PORT=8000
MARKET_DATA_PROVIDER=yahoo
NEWS_PROVIDER=free
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-opus-5
BEDROCK_ENABLED=true

# Optional: comma-separated Yahoo Finance symbols. Leave blank for the built-in NSE watchlist.
LIVE_SYMBOLS=

# For Railway, configure AWS credentials as service secrets instead of committing them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
