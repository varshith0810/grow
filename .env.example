APP_ENV=development
CORS_ORIGINS=["http://localhost:3000"]
API_PORT=8000
MARKET_DATA_PROVIDER=free
NEWS_PROVIDER=free
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=anthropic.claude-opus-5-20260724-v1:0
DATABASE_URL=postgresql://market:market@postgres:5432/market
REDIS_URL=redis://redis:6379/0
# Live market data (Upstox)
# Set this only in Railway/server secrets; never commit a real token.
UPSTOX_ANALYTICS_TOKEN=
BEDROCK_ENABLED=false
# Optional: comma-separated Upstox instrument keys. Leave blank to load NSE equity instruments automatically.
UPSTOX_INSTRUMENT_KEYS=
UPSTOX_MAX_INSTRUMENTS=2000
